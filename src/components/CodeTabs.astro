---
interface Props {
  tabs: { label: string; lang?: string }[];
}
const { tabs } = Astro.props;
const tabGroup = `code-tabs-${crypto.randomUUID()}`;
---

<div class="code-tabs" data-tab-group={tabGroup}>
  <div class="code-tabs__buttons" role="tablist" aria-label="Code language" hidden>
    {tabs.map((tab, index) => (
      <button
        type="button"
        class="code-tabs__btn"
        id={`${tabGroup}-tab-${index}`}
        aria-controls={`${tabGroup}-panel-${index}`}
        aria-selected={index === 0 ? "true" : "false"}
        tabindex={index === 0 ? 0 : -1}
        role="tab"
      >
        {tab.label}
      </button>
    ))}
  </div>
  <div class="code-tabs__panels"><slot /></div>
</div>

<style>
  .code-tabs { min-width: 0; }
  .code-tabs__buttons {
    display: flex;
    gap: .25rem;
    border-bottom: 1px solid var(--line-2, #2a2f3a);
  }
  .code-tabs__buttons[hidden] { display: none; }
  .code-tabs__btn {
    background: transparent;
    border: none;
    color: var(--ink-2, #9aa4b2);
    font-family: "JetBrains Mono", monospace;
    font-size: .85rem;
    padding: .5rem 1rem;
    cursor: pointer;
    border-bottom: 2px solid transparent;
  }
  .code-tabs__btn[aria-selected="true"] {
    color: var(--ink, #f5efe4);
    border-bottom-color: var(--accent, #59c2ff);
  }
  .code-tabs__panels > :global([hidden]) { display: none !important; }
</style>

<script>
  function initializeCodeTabs() {
    document.querySelectorAll<HTMLElement>(".code-tabs").forEach(wrapper => {
      const buttons = [...wrapper.querySelectorAll<HTMLButtonElement>(".code-tabs__btn")];
      const panels = [...wrapper.querySelectorAll<HTMLElement>(".code-tabs__panels > *")];
      const tablist = wrapper.querySelector<HTMLElement>('[role="tablist"]');
      if (!tablist || !buttons.length || buttons.length !== panels.length) return;
      const select = (index: number, focus = false) => {
        buttons.forEach((button, position) => {
          button.setAttribute("aria-selected", String(position === index));
          button.tabIndex = position === index ? 0 : -1;
          panels[position].hidden = position !== index;
        });
        if (focus) buttons[index].focus();
      };
      panels.forEach((panel, index) => {
        panel.id = `${wrapper.dataset.tabGroup}-panel-${index}`;
        panel.setAttribute("role", "tabpanel");
        panel.setAttribute("aria-labelledby", buttons[index].id);
        panel.tabIndex = 0;
      });
      buttons.forEach((button, index) => {
        button.addEventListener("click", () => select(index));
        button.addEventListener("keydown", event => {
          let next = index;
          if (event.key === "ArrowRight") next = (index + 1) % buttons.length;
          else if (event.key === "ArrowLeft") next = (index + buttons.length - 1) % buttons.length;
          else if (event.key === "Home") next = 0;
          else if (event.key === "End") next = buttons.length - 1;
          else return;
          event.preventDefault();
          select(next, true);
        });
      });
      select(0);
      tablist.hidden = false;
    });
  }
  // Run after the shared script has added copy controls around code blocks.
  if (document.readyState === "complete") initializeCodeTabs();
  else document.addEventListener("DOMContentLoaded", initializeCodeTabs, { once: true });
</script>

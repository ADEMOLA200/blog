---
import type { CollectionEntry } from "astro:content";
import { noteInfo } from "../lib/notes";
interface Props { post: CollectionEntry<"posts">; index?: number; latest?: boolean; }
const { post, index = 1, latest = false } = Astro.props;
const note = noteInfo(post);
---
<article class:list={["note", { "note--latest": latest }]} data-category={note.cat} data-minutes={note.minutes}>
  <div class="note__media">
    <img src={note.card} width="630" height="380" alt="" loading="lazy" decoding="async" />
    <span class="note__tag" data-cat={note.cat}>{note.topic}</span>
    <span class="note__no">No.{String(index).padStart(2, "0")}</span>
  </div>
  <div class="note__body">
    <h3 class="note__title"><a class="note__link" href={note.href}>{note.title}</a></h3>
    <p class="note__meta">
      <span class="note__byline"><span class="nw">{post.data.author} ·</span> <span class="nw"><time datetime={post.data.publishedDate.toISOString()}>{note.date}</time> · {note.minutes} min</span></span>
      <span class="note__read" aria-hidden="true">Read note <span class="arr">→</span></span>
    </p>
  </div>
</article>
